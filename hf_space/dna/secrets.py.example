# Copy this file to secrets.py and fill in your API keys.
# Each provider takes a list of keys; the request layer round-robins across
# them and rotates on rate-limit / quota errors.

# Google Gemini (https://ai.google.dev/)
GOOGLE_API_KEYS = [
]
# Separate pool for preview / early-access Gemini models.
GOOGLE_API_KEYS_PREVIEW = [
]

# OpenAI GPT (https://platform.openai.com/)
OPENAI_API_KEYS = [
]

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEYS = [
]

# Meta Muse Spark
META_API_KEYS = [
]

# OpenRouter (https://openrouter.ai/) — one endpoint for GPT, Claude, and many
# others; handy for debugging without each vendor's own key. Preferred via the
# OPENROUTER_API_KEY environment variable; this list is an optional fallback.
OPENROUTER_API_KEYS = [
]
